{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" session-start" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" prompt" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" guard" }] },
      { "matcher": "SubagentHandback",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" handback-gate" }] }
    ],
    "PostToolUse": [
      { "matcher": "SubagentHandback",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" handback-post" }] },
      { "matcher": "TaskStop",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" taskstop-post" }] },
      { "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" agent-post" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" subagent-start" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" subagent-stop" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/delegate.py\" stop-gate" }] }
    ]
  }
}
