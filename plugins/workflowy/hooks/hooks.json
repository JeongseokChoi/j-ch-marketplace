{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "timeout": 15,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" session-start" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" prompt" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" stop" }] }
    ],
    "Notification": [
      { "matcher": "idle_prompt",
        "hooks": [{ "type": "command", "timeout": 15, "async": true,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" idle" }] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "timeout": 15, "async": true,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" agent-launch" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" session-end" }] }
    ]
  }
}
