{
  "hooks": {
    "SessionStart": [
      { "matcher": "resume|compact",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" session-start" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "timeout": 30,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" prompt" }] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__plugin_workflowy_workflowy__.*",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" guard" }] },
      { "hooks": [{ "type": "command", "timeout": 15, "async": true,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" step" }] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__plugin_workflowy_workflowy__.*",
        "hooks": [{ "type": "command", "timeout": 10,
                    "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wf.py\" track" }] }
    ]
  }
}
